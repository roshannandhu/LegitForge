# Copy to .dev.vars for local secrets (`next dev` and `npm run preview` read it).
# Production: `npx wrangler secret put NAME` for each. PLAN §8.7 lists them all.

# Hashes IPs in the rate limiter so raw addresses are never stored (§13)
HASH_SALT=change-me-to-a-long-random-string

# Optional website enquiries -> n8n -> internal Telegram alert. Configure BOTH values only after
# n8n authenticates x-lf-key and deduplicates the stable lead ID/idempotency-key.
# D1 outbox retains delivery state and retries temporary failures; blank means no alert is sent.
N8N_LEAD_WEBHOOK_URL=
N8N_SHARED_KEY=

# Turnstile (§13.3). Server-side verification is enforced whenever this is set.
# The widget also needs NEXT_PUBLIC_TURNSTILE_SITE_KEY at build time (.env.local locally,
# the GitHub Actions repository variable in production). Set both, or neither.
# Cloudflare's test keys: secret 1x0000000000000000000000000000000AA always passes,
# 2x0000000000000000000000000000000AA always fails; site key 1x00000000000000000000AA.
TURNSTILE_SECRET_KEY=

# Admin (/admin, PLAN §7.8): Google sign-in (lib/admin/auth.ts, README "Admin").
# The owners: these Google accounts (comma-separated) can always sign in; add others in Admin → Access.
ADMIN_EMAILS=
# Signs the admin session cookie: a long random string. Changing it signs everyone out.
ADMIN_SESSION_KEY=
# Local only: 1 opens /admin on localhost without signing in. Never set it in production.
ADMIN_DEV_BYPASS=
# Admin → Projects → "Add from GitHub". A fine-grained GitHub token with read-only "Contents" and
# "Metadata" on your repos. Needed for private repos; public ones work without it (60 reads/hour).
GITHUB_TOKEN=
# Local tests only (with ADMIN_DEV_BYPASS): a fixture server instead of api.github.com.
GITHUB_API_BASE=
