{
  "name": "legit-forge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/blog-index.mjs && next dev",
    "build": "node scripts/blog-index.mjs && next build",
    "start": "next start",
    "check": "node scripts/check.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply legitforge --local",
    "db:migrate:remote": "wrangler d1 migrations apply legitforge --remote"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/rapier": "^2.2.0",
    "@types/mdx": "^2.0.14",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "meshline": "^3.3.1",
    "motion": "^12.43.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.2",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.140.0"
  }
}
